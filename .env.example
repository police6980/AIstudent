# ==========================================================================
# Vygotsky Science Tutor — environment variables template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==========================================================================

# --- LLM (Claude) ---
# Required. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model for student dialogue (cost / latency tuned).
# Options: claude-sonnet-4-6 (default), claude-opus-4-7 (quality), claude-haiku-4-5-20251001 (fast)
CLAUDE_MODEL=claude-sonnet-4-6

# --- Speech-to-Text (Whisper) — used from Milestone 2 ---
OPENAI_API_KEY=

# --- Text-to-Speech (ElevenLabs primary, OpenAI fallback) — Milestone 2 ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Email (teacher reports) — Milestone 4 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- App runtime ---
# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///data/sessions.db
# Directory for generated PDF reports
REPORT_DIR=data/reports
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Delete raw student audio immediately after STT. Keep true unless debugging.
KEEP_AUDIO_FILES=false
# Session data retention (days). Automatic purge in Milestone 5.
SESSION_RETENTION_DAYS=30
