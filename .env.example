# ==========================================================================
# 예비교사 과학 설명 훈련 시스템 — 환경 변수 템플릿
# 이 파일을 `.env` 로 복사하고 실제 값을 채우세요. `.env` 는 절대 커밋하지 않습니다.
# ==========================================================================

# --- LLM (Claude) ---
# 필수. https://console.anthropic.com/ 에서 발급.
ANTHROPIC_API_KEY=
# 대화용 모델 (속도·비용 최적)
CLAUDE_MODEL=claude-sonnet-4-6
# 분석·리포트용 모델 (품질 우선, Phase B)
CLAUDE_ANALYSIS_MODEL=claude-opus-4-7

# --- Speech-to-Text (Whisper) — Phase C(음성) 에서 사용 ---
OPENAI_API_KEY=

# --- Text-to-Speech (Phase C) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- 교수자 관리 페이지 ---
# ?admin=true URL 접속 시 이 비밀번호를 물어봅니다.
# 비워두면 관리 페이지가 비활성화됩니다.
INSTRUCTOR_PASSWORD=

# --- 앱 런타임 ---
# SQLite 파일 경로 (프로젝트 루트 기준)
DATABASE_URL=sqlite:///data/sessions.db
# PDF 리포트 저장 디렉토리
REPORT_DIR=data/reports
# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 학생 음성 원본을 STT 직후 삭제할지. 디버깅 외에는 false 유지 권장.
KEEP_AUDIO_FILES=false
# 세션 데이터 보존 기간(일). Phase D에서 자동 정리.
SESSION_RETENTION_DAYS=30
